# Copy to backend/.env and adjust as needed. All values have sane defaults
# in app/config.py; this file only needs entries you want to override.

CORS_ORIGINS=["http://localhost:3000"]

# Cache TTLs (seconds)
TTL_QUOTE_MARKET_HOURS=30
TTL_QUOTE_CLOSED=3600
TTL_HISTORY_DAILY=21600
TTL_FINANCIALS=43200

# Yahoo throttling
YAHOO_MAX_CONCURRENCY=4
YAHOO_RETRY_ATTEMPTS=3
YAHOO_RETRY_BACKOFF_SECONDS=1.5
